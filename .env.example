# Environment & Port
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
MONGODB_URI=

# Security & Authentication
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_KEY=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_USERNAME=

# Protected Super Admin Owner (Firebase Authentication)
# The owner's email is not secret. The owner's PASSWORD must never go in this
# file, in Git, or in Firestore. Supply it only when running
# `npm run owner:provision`, e.g. from your secret manager, then unset it.
SUPER_ADMIN_EMAIL=12rakosadavid@gmail.com
# SUPER_ADMIN_PASSWORD=   <- set only in your shell/secret manager at provisioning time
# Service-account key used by the server to verify owner sign-ins and by the
# provisioning script. Keep the key file out of Git.
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudflare Turnstile CAPTCHA (Optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS & Notification Providers
SMS_DRIVER=local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# WhatsApp Gateway (Optional)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# Email SMTP Gateway (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@rentaroomsoweto.co.za

# Google Gemini AI Advisor
GEMINI_API_KEY=

# Firebase Storage & Project
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
