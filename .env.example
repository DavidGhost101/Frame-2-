# Environment & Port
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
MONGODB_URI=

# Security & Authentication
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_KEY=

# Cloudflare Turnstile CAPTCHA (Optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS & Notification Providers
SMS_DRIVER=local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# WhatsApp Gateway (Optional)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# Email SMTP Gateway (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@rentaroomsoweto.co.za

# Google Gemini AI Advisor
GEMINI_API_KEY=
